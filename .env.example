# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit real secrets.

# Required: Anthropic API key for Claude scoring
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required: Telegram bot credentials
# Create a bot via @BotFather on Telegram, then get chat_id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: RemoteRocketship Jobs API (Advanced plan subscription required)
# Get yours at: https://www.remoterocketship.com/account/ -> Advanced -> API access
REMOTEROCKETSHIP_API_KEY=
